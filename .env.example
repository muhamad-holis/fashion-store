# =========================================================
# SUPABASE
# Ambil dari: Supabase Dashboard > Project Settings > API
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# JANGAN pernah expose service role key ke client. Hanya dipakai di server (API routes).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =========================================================
# SITE
# =========================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Fashion Store"

# =========================================================
# SHIPPING (opsional - RajaOngkir / Komerce / Biteship dsb)
# Jika kosong, sistem otomatis pakai kalkulasi ongkir manual berbasis berat & kota.
# =========================================================
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1

# =========================================================
# EMAIL (untuk notifikasi status pesanan) - contoh pakai Resend
# =========================================================
RESEND_API_KEY=
EMAIL_FROM="Fashion Store <no-reply@yourdomain.com>"

# =========================================================
# APP
# =========================================================
NEXTAUTH_SECRET=generate-random-string-here
